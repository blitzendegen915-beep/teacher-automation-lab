--track0:BPM,40.00,300.00,120.00,0.01
--track1:強さ,0.0,200.0,15.0,0.1
--track2:キレ,0.5,60.0,10.0,0.1
--track3:ズレms,-2000,2000,0,1
--check0:2拍ごとにする,0
@ビートパンチ
--[[
  曲のビートに合わせて、瞬間的にズームインさせるアニメーション効果。
  カットを割らなくてもリズム感が出るので、音ハメの土台に使う。

  BPM     : 曲のテンポ。配布ページの表記か、beatgrid.html のタップ計測で調べる。
  強さ     : ズームの最大量(%)。15～25で自然、40を超えるとかなり派手。
  キレ     : 元の大きさに戻る速さ。大きいほど鋭く、小さいほど余韻が残る。
  ズレms   : 音とタイミングが合わないときに前後させる(ミリ秒)。
  2拍ごと  : オンにすると1拍おきに間引く。速い曲で使う。
]]

-- 1拍あたりの秒数
local beat = 60 / obj.track0
if obj.check0 then
    beat = beat * 2
end

local t = obj.time - obj.track3 / 1000

if t >= 0 then
    -- 直前のビートからの経過秒
    local phase = t % beat
    -- 経過するほど 1 → 0 に減っていく（打った直後が一番大きい）
    local level = math.exp(-phase * obj.track2)
    obj.zoom = obj.zoom * (1 + obj.track1 / 100 * level)
end
