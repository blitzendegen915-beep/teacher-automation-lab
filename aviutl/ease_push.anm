--track0:拡大量,-50.0,50.0,8.0,0.1
--track1:横移動,-800,800,0,1
--track2:縦移動,-800,800,0,1
--track3:カーブ,-100,100,60,1
--check0:逆にする,0
@イーズ寄り
--[[
  オブジェクトの長さいっぱいをかけて、ゆっくり寄る（または引く・流す）。
  カーブ1本で、動きの緩急を連続的に変えられるのがこの効果の要点。

  拡大量 : 最終的に何%大きくなるか。歩きや準備のカットは5～10で十分。
  横移動 : 最終的に横へ動く量(px)。
  縦移動 : 最終的に縦へ動く量(px)。
  カーブ : 動きの緩急。
             +100 … 勢いよく動き出して、長く余韻を残して止まる（イーズアウト）
                0 … 等速
             -100 … そろそろ動き出して、最後に加速する（イーズイン）
  逆にする : 終わりの状態から始めて、元に戻る。引きの動きにするときに使う。

  使い分けの目安:
    寄り・止め絵に動きを足す      → カーブ +40～+80
    これから何かが起きる、の予感   → カーブ -40～-70
    機械的・無機質に見せたい       → カーブ 0

  映像では「動き出しは速く、止まりは長く」が自然に見える。
  迷ったらプラス側にしておくとよい。
]]

local total = obj.totaltime
local p = 0
if total > 0 then
    p = obj.time / total
end
if p < 0 then p = 0 end
if p > 1 then p = 1 end

if obj.check0 then
    p = 1 - p
end

-- カーブの強さを、べき乗の指数に変換する（0で等速、離れるほど曲がる）
local k = obj.track3 / 100
local a = 1 + math.abs(k) * 3

if k > 0 then
    -- 速く動き出して、ゆっくり止まる
    p = 1 - (1 - p) ^ a
elseif k < 0 then
    -- ゆっくり動き出して、最後に加速する
    p = p ^ a
end

obj.ox = obj.ox + obj.track1 * p
obj.oy = obj.oy + obj.track2 * p
obj.zoom = obj.zoom * (1 + obj.track0 / 100 * p)
