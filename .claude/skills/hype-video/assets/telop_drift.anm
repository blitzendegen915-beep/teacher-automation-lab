--track0:横に流す,-800,800,0,1
--track1:縦に流す,-800,800,150,1
--track2:拡大変化,-50.0,50.0,4.0,0.1
--track3:出入り,0.00,3.00,0.40,0.01
--check0:動きをなめらかに,0
@テロップドリフト
--[[
  文字をオブジェクトの長さいっぱいかけて、ゆっくり一定速度で流す。
  下の映像を何回も切り替えながら、キャッチコピーだけを数秒出しっぱなしにする
  ――という見せ方に使う。ハイプ動画で一番効く文字の出し方。

  横に流す : 全体で横に動く量(px)。0で縦だけ。
  縦に流す : 全体で縦に動く量(px)。プラスで上から下へ。
  拡大変化 : 全体で何%大きくなるか。3～6程度のわずかな変化が効く。
  出入り   : 最初と最後のフェード秒数。0で出っぱなし。
  なめらか : オンで動き出しと止まりが緩む。オフは等速（こちらが基本）。

  使い方：
    1. テキストオブジェクトを 3秒前後の長さで置く
    2. その下のレイヤーで映像を 5～10カットに割る
    3. テキストにこの効果を追加する
  文字は動かず映像だけが変わるので、文の重みが出る。
]]

local total = obj.totaltime
local p = 0
if total > 0 then
    p = obj.time / total
end
if p < 0 then p = 0 end
if p > 1 then p = 1 end

if obj.check0 then
    -- 両端で緩やかになる曲線
    p = p * p * (3 - 2 * p)
end

-- 中央を基準にして前後に振り分ける（真ん中で元の位置になる）
local c = p - 0.5

obj.ox = obj.ox + obj.track0 * c
obj.oy = obj.oy + obj.track1 * c
obj.zoom = obj.zoom * (1 + obj.track2 / 100 * c)

local f = obj.track3
if f > 0 and total > 0 then
    local a = math.min(obj.time / f, (total - obj.time) / f, 1)
    if a < 0 then a = 0 end
    obj.alpha = obj.alpha * a
end
